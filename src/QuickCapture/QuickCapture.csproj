<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/QuickCapture.ico</ApplicationIcon>
    <AssemblyName>QuickCapture</AssemblyName>
    <Version>1.7.0</Version>
    <!-- WPF owns startup/DPI; WinForms is used only for the notification icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- A self-contained publish carries the whole Windows Desktop runtime, whose
         translated resources for thirteen languages take about 15 MB of it. Keep
         the two the app is read in and leave the rest out of the exe. -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/QuickCapture.ico"/></ItemGroup>
</Project>
